# 1. Klucz API modelu językowego (Google AI Studio "AIza..." lub Vertex AI Express "AQ...")
# Przetwarzanie danych: Dane przed wysyłką do API przechodzą przez lokalny filtr
# RODO Shield w przeglądarce użytkownika (anonimizacja PESEL, NIP i nazw wykonawców).
GEMINI_API_KEY="twoj_klucz_gemini_api_tutaj"

# 2. Adres kopii ogłoszeń Biuletynu Zamówień Publicznych (BZP) dla sektora wod-kan
# Zgodnie z dokumentacją MFiPR na czas HackNation 2026 używane jest lustro bez limitu 30 req/min:
NEXT_PUBLIC_BZP_API_URL="https://bzp.cytr.us"
